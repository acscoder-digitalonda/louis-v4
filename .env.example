# ─────────────────────────────────────────────────────────────────────────────
# Louis v3 — environment contract.
# Copy to .env.local for development. Real values live in Vercel's env settings.
# NO KEY EVER GOES IN THE REPO, AND NO KEY EVER GOES IN AN AIRTABLE FIELD.
#
# The app runs with none of these set: it falls back to mock data and demo auth,
# which is how a fresh clone is reviewable in one command.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data layer — the only database ───────────────────────────────────────────
# Personal access token with data.records:read/write + schema.bases:read on the base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Force a backend: "airtable" | "mock". Unset = airtable when credentials exist.
DATA_BACKEND=
# Shown in Settings → Mirror as the fallback surface if this app is ever down.
AIRTABLE_FALLBACK_INTERFACE_URL=

# ── Auth — Google SSO only, no password path, ever ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Seed allowlist, "email:role" comma-separated. Roles: owner | admin | ops | accountant.
# The Users table in Airtable is authoritative once it exists; this is the way in before it does.
ALLOWLIST=jordan@bennemtin.com:admin,acscoder@digitalonda.com:admin

# ── Team addresses (task assignment + notification routing) ──────────────────
OWNER_EMAIL=
OPS_EMAIL=
ADMIN_EMAIL=
# Extra domains treated as internal for notification email. Comma-separated.
INTERNAL_EMAIL_DOMAINS=

# ── AI gateway ───────────────────────────────────────────────────────────────
# Production path. Without it there is no fallback tier.
OPENROUTER_API_KEY=
# Phase 0 local runner; only used when Settings → AI → backend is "claude-code".
CLAUDE_CODE_BIN=claude
AI_TIMEOUT_MS=60000

# ── Google mirror + Gmail (optional; the mirror is redundancy, never a dependency) ──
GMAIL_REFRESH_TOKEN=
GMAIL_SERVICE_ADDRESS=
GMAIL_WATCH_LABEL=louis-intake
EMAIL_INTAKE_BATCH=25
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_DEALS_FOLDER_ID=

# ── Public form intake (F1) ──────────────────────────────────────────────────
# Shared token the website form sends as x-intake-token. Leave blank to accept unauthenticated posts.
FORM_INTAKE_TOKEN=
FORM_INTAKE_ORIGIN=
QUESTIONNAIRE_URL=
SPEAKER_ASSETS_URL=
OVERVIEW_URL=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Required in production. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# ── Behaviour flags ──────────────────────────────────────────────────────────
# Off by default and it should stay that way: approving a draft puts it in Gmail for a
# human to send. Setting this true makes "approve" send directly to the client.
SEND_ON_APPROVE=false
# Demo mode identity when Google SSO is not configured (never used in production).
DEMO_USER_EMAIL=
DEMO_USER_ROLE=admin

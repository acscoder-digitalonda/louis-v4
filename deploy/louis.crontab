# Louis workers. Generated by `npm run schedule` — edit the registry, not this file.
#
# Install:  crontab -l > /tmp/cur && cat deploy/louis.crontab >> /tmp/cur && crontab /tmp/cur
# Requires: CRON_SECRET filled in below, matching the value set on the app.
#
# CRON_TZ matters more than it looks. These are human times, not machine times:
# 7am is when the morning digest lands on somebody's phone, and 5:30 is when the QA
# sweep finishes before anyone is up. A VPS is almost always on UTC, so without this
# line the digest arrives at midnight Pacific and the reply-SLA sweep runs through
# the night and sleeps through the working day. It is the speaker's timezone because
# the people reading the output are in it.

SHELL=/bin/bash
CRON_TZ=America/Los_Angeles
CRON_SECRET=replace-me

# Email intake (critical: runs even at the AI cap)
0 * * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f2-email-intake > /dev/null

# Research agent
0 8 * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f3-research > /dev/null

# Timers (critical: runs even at the AI cap)
0 7 * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f6-timers > /dev/null

# Google mirror (critical: runs even at the AI cap)
0 * * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f9-mirror > /dev/null

# QA sweep
30 5 * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f13-qa-sweep > /dev/null

# Reply SLA (critical: runs even at the AI cap)
0 * * * * curl -sS --fail --max-time 280 -H "Authorization: Bearer $CRON_SECRET" https://louis-v3.vercel.app/api/cron/f14-sla > /dev/null
